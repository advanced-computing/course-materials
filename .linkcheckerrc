[checking]
useragent="AdvancedComputingLinkChecker/1.0 (https://github.com/advanced-computing/course-materials; alf2215@columbia.edu)"

[filtering]
checkextern=1
# https://github.com/linkchecker/linkchecker/issues/823
ignorewarnings=http-redirected,url-content-type-unparseable

[output]
ignoreerrors=
  .* 401 Unauthorized
  .* 403 Forbidden
  .* 429 Too Many Requests
  .* 502 Bad Gateway
  .* 503 Service Unavailable
  .* 504 Gateway Timeout
  .* ReadTimeout:
  .* ConnectionError:
  ^https://.*\.columbia.edu/ Forbidden|400
  ^https://github.com/advanced-computing/course-materials/tasks/ 404
  ^https://nyshc.health.ny.gov SSLError

[MarkdownCheck]
